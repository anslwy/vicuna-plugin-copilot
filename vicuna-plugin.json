{
  "id": "copilot",
  "name": "GitHub Copilot Harness",
  "version": "1.2.0",
  "description": "Adds the GitHub Copilot CLI as a Work harness, driven over ACP (`copilot --acp --stdio`).",
  "icon": "copilot.svg",
  "harnesses": [
    {
      "id": "copilot",
      "label": "Copilot",
      "acp": {
        "command": "copilot",
        "args": [
          "--acp",
          "--stdio"
        ]
      },
      "installHint": "Install the Copilot CLI (npm install -g @github/copilot), run `copilot login` once, then reopen Work. Usage needs the GitHub CLI (`gh auth login`).",
      "installUrl": "https://docs.github.com/en/copilot/reference/acp-server",
      "icon": "copilot.svg",
      "usage": {
        "command": "gh",
        "args": [
          "api",
          "/copilot_internal/user"
        ],
        "map": {
          "plan": "/copilot_plan",
          "meters": [
            {
              "label": "AI credits",
              "remainingPercent": "/quota_snapshots/chat/percent_remaining",
              "resetsAt": "/quota_reset_date_utc"
            },
            {
              "label": "Completions",
              "remainingPercent": "/quota_snapshots/completions/percent_remaining",
              "resetsAt": "/quota_reset_date_utc"
            }
          ]
        }
      },
      "accounts": {
        "env": {
          "COPILOT_HOME": "copilot",
          "GH_CONFIG_DIR": "gh"
        },
        "clear": [
          "COPILOT_GITHUB_TOKEN",
          "GH_TOKEN",
          "GITHUB_TOKEN"
        ],
        "login": [
          {
            "command": "copilot",
            "args": [
              "login"
            ]
          },
          {
            "command": "gh",
            "args": [
              "auth",
              "login",
              "--hostname",
              "github.com",
              "--web"
            ]
          }
        ],
        "signedIn": {
          "file": "copilot/config.json",
          "pointer": "/loggedInUsers/0"
        }
      }
    }
  ]
}
